--check@entry_out:退場,0
--group

--group:フェード,true
--check@entry_in_fade:INフェード,0
--track@in_fade_time:インフェード時間,0,5,0.3,0.01
--check@entry_out_fade:OUTフェード,0
--track@out_fade_time:アウトフェード時間,0,5,0.3,0.01
--group

local Helper = require("entry_helper")

-- トラックバー等からのパラメータをテーブルに集約
local params = {
    entry_order = entry_order,
    entry_easing = entry_easing,
    entry_delay = entry_delay,
    entry_time = entry_time,
    in_time = in_time,
    out_time = out_time,
    entry_in = entry_in,
    entry_out = entry_out,
    entry_in_fade = entry_in_fade,
    in_fade_time = in_fade_time,
    entry_out_fade = entry_out_fade,
    out_fade_time = out_fade_time
}

-- 共通処理の呼び出し
local ease_t, out_ease_t = Helper.calc_ease(params)
Helper.apply_fade(params)

-------------------------- 形状選択

local type_name = {
    [0] = "通常",
    [1] = "クロス(4本)",
    [2] = "クロス(6本)",
    [3] = "クロス(8本)",
    [4] = "クロス(10本)",
    [5] = "クロス(12本)",
    [6] = "ライン",
}

local shape_val = type_name[shpae_glow2] or "通常"

-------------------------- チェックボックスで光色を無効化するか否か

if disable == 1 then
    g2_col = nil
else
    g2_col = glow2_color
end

-------------------------- エフェクト適用
local c_str = (ease_t + out_ease_t) * (entry_strength or 50)
if type(g2_col) == "number" then
    obj.effect("グロー","強さ",c_str,"拡散",glow2_diffusion,"角度",glow2_angle,"しきい値",glow2_threshold,"比率",glow2_ratio,"ぼかし",glow2_blur,"形状",shape_val,"光色",g2_col)
else
    obj.effect("グロー","強さ",c_str,"拡散",glow2_diffusion,"角度",glow2_angle,"しきい値",glow2_threshold,"比率",glow2_ratio,"ぼかし",glow2_blur,"形状",shape_val)
end

