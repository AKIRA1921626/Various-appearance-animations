    [0] = "赤緑A",
    [1] = "赤青A",
    [2] = "緑青A",
    [3] = "赤緑B",
    [4] = "赤青B",
    [5] = "緑青B",
}

local shift_type = color[type]
local c_w = (ease_t + out_ease_t) * (entry_width or 7)
obj.effect("色ずれ", "ずれ幅", c_w, "角度", shift_angle, "強さ", shift_strength, "色ずれの種類", shift_type)

