@発光登退場_AKIRA
--label:切り替え効果
--information:発光を適用して登退場を行うスクリプトです。
--track@entry_time:登退場秒数,0,5,0.3,0.01
--track@in_time:登場秒数,0,5,0,0.01
--track@out_time:退場秒数,0,5,0,0.01
--track@entry_strength:強さ,-4000,4000,500
--track@glow_diffusion:拡散,0,4000,250
--track@glow_threshold:しきい値,0,100,80
--track@glow_speed:拡散速度,0,4000,0
--check@glow_fix_size:サイズ固定,0
--color@glow_color:光色,0xffffff
--select@entry_order:登場順=0,前から=0,後ろから=1,真ん中から=2,ランダム=3,外側から=4
--track@entry_delay:間隔,0,5,0.1,0.01
--select@entry_easing:イージングタイプ=3,Linear(等速)=0,inSine(正弦波:緩やかな加速)=1,inQuad(二次:標準的な加速)=2,inCubic(三次:強めの加速)=3,inQuart(四次:かなり強い加速)=4,inQuint(五次:非常に強い加速)=5,inCirc(円弧:最後に急加速)=6,inExpo(指数:急激な加速)=7,inBack(戻り:少し戻って加速)=8,inElastic(弾性:揺れてから加速)=9,inBounce(跳ね返り:跳ねて加速)=10,outSine(正弦波:緩やかに減速)=11,outQuad(二次:標準的な減速)=12,outCubic(三次:強めの減速)=13,outQuart(四次:かなり強い減速)=14,outQuint(五次:非常に強い減速)=15,outCirc(円弧:急激に減速)=16,outExpo(指数:瞬時に減速)=17,outBack(戻り:通り過ぎて戻る)=18,outElastic(弾性:揺れて減速)=19,outBounce(跳ね返り:着地して跳ねる)=20,inOutSine(正弦波:滑らかな加減速)=21,inOutQuad(二次:標準的な加減速)=22,inOutCubic(三次:強めの加減速)=23,inOutQuart(四次:かなり強い加減速)=24,inOutQuint(五次:非常に強い加減速)=25,inOutCirc(円弧:急激な加減速)=26,inOutExpo(指数:中央で急移動)=27,inOutBack(戻り:開始終了で戻る)=28,inOutElastic(弾性:開始終了で揺れる)=29,inOutBounce(跳ね返り:開始終了で跳ねる)=30

--group:登退場,true
--check@entry_in:登場,1
--check@entry_out:退場,0
--group

--group:フェード,true
--check@entry_in_fade:INフェード,0
--track@in_fade_time:インフェード時間,0,5,0.3,0.01
--check@entry_out_fade:OUTフェード,0
--track@out_fade_time:アウトフェード時間,0,5,0.3,0.01
--group

local Helper = require("entry_helper")

-- トラックバー等からのパラメータをテーブルに集約
local params = {
    entry_order = entry_order,
    entry_easing = entry_easing,
    entry_delay = entry_delay,
    entry_time = entry_time,
    in_time = in_time,
    out_time = out_time,
    entry_in = entry_in,
    entry_out = entry_out,
    entry_in_fade = entry_in_fade,
    in_fade_time = in_fade_time,
    entry_out_fade = entry_out_fade,
    out_fade_time = out_fade_time
}

-- 共通処理の呼び出し
local ease_t, out_ease_t = Helper.calc_ease(params)
Helper.apply_fade(params)

-------------------------- エフェクト適用
local c_strength = (ease_t + out_ease_t) * (entry_strength or 100)
local col = (glow_color == "_" or glow_color == nil) and nil or tonumber(glow_color)
obj.effect("発光","強さ",c_strength,"拡散",glow_diffusion,"しきい値",glow_threshold,"拡散速度",glow_speed,"光色",col,"サイズ固定",glow_fix_size)

