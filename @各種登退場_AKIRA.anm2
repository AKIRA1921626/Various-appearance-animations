local Helper = require("entry_helper")

-- トラックバー等からのパラメータをテーブルに集約
local params = {
    entry_order = entry_order,
    entry_easing = entry_easing,
    entry_delay = entry_delay,
    entry_time = entry_time,
    in_time = in_time,
    out_time = out_time,
    entry_in = entry_in,
    entry_out = entry_out,
    entry_in_fade = entry_in_fade,
    in_fade_time = in_fade_time,
    entry_out_fade = entry_out_fade,
    out_fade_time = out_fade_time
}

-- 共通処理の呼び出し
local ease_t, out_ease_t = Helper.calc_ease(params)
Helper.apply_fade(params)

-------------------------- エフェクト適用
local c_range = (ease_t + out_ease_t) * (entry_range or 360)
obj.effect("扇クリッピング","中心X",entry_fan_x or 0,"中心Y",entry_fan_y or 0,"基準角",entry_fan_ang or 0,"範囲角",c_range,"ぼかし",entry_blur or 1,"基準角を中央にする",fan_center or 0)

