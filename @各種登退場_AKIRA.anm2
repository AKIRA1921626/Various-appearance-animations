    [8] = "比較(暗)",
    [9] = "輝度",
    [10] = "色差",
    [11] = "陰影",
    [12] = "明暗",
    [13] = "差分"
}

-------------------------- エフェクト適用
local start_x = kirari_sx or -150
local end_x = kirari_ex or 200
local current_x = end_x + (start_x - end_x) * (ease_t + out_ease_t)
local c_x = current_x
local c_y = kirari_y or 0
if kirari_rel ~= 0 then
    c_x = (current_x / 100) * obj.w
    c_y = (c_y / 100) * obj.h
end
local st = entry_str or 100
local w = kirari_w or 100
obj.effect("グラデーション","強さ",st,"中心X",c_x,"中心Y",c_y,"角度",kirari_ang or 10,"幅",w,"合成モード",composites_name[kirari_composite],"形状",mode_name[kirari_type],"開始色",kirari_col)

