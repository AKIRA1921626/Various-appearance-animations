--check@entry_out_fade:OUTフェード,0
--track@out_fade_time:アウトフェード時間,0,5,0.3,0.01
--group

local Helper = require("entry_helper")

-- トラックバー等からのパラメータをテーブルに集約
local params = {
    entry_order = entry_order,
    entry_easing = entry_easing,
    entry_delay = entry_delay,
    entry_time = entry_time,
    in_time = in_time,
    out_time = out_time,
    entry_in = entry_in,
    entry_out = entry_out,
    entry_in_fade = entry_in_fade,
    in_fade_time = in_fade_time,
    entry_out_fade = entry_out_fade,
    out_fade_time = out_fade_time
}

-- 共通処理の呼び出し
local ease_t, out_ease_t = Helper.calc_ease(params)
Helper.apply_fade(params)

-------------------------- 合成モード,形状,の変数を文字列へ変換

local mode_name = {
    [1] = "線形",
    [2] = "円形",
    [3] = "矩形",
    [4] = "凸形"
}

local composites_name = {
    [1] = "通常",
    [2] = "加算",
    [3] = "減算",
    [4] = "乗算",
    [5] = "スクリーン",
    [6] = "オーバーレイ",
    [7] = "比較(明)",
    [8] = "比較(暗)",
    [9] = "輝度",
    [10] = "色差",
    [11] = "陰影",
    [12] = "明暗",
    [13] = "差分"
}

-------------------------- エフェクト適用
local start_x = kirari_sx or -300
local end_x = kirari_ex or 500
local current_x = end_x + (start_x - end_x) * (ease_t + out_ease_t)
local c_x = current_x
local c_y = kirari_y or 0
if kirari_rel ~= 0 then
    c_x = (current_x / 100) * obj.w
    c_y = (c_y / 100) * obj.h
end
local st = entry_str or 100
local w = kirari_w or 100
obj.effect("グラデーション","強さ",st,"中心X",c_x,"中心Y",c_y,"角度",kirari_ang or 120,"幅",w,"合成モード",composites_name[kirari_composite],"形状",mode_name[kirari_type],"開始色",kirari_col)

